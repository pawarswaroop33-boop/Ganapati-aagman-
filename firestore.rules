rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Invitations are public to allow friends and family to view the card across any device
    match /invitations/{invitationId} {
      allow read: if true;
      allow create, update: if request.resource.data.familyName is string
                            && request.resource.data.bappaImageUrl is string;
      allow delete: if false;
    }
  }
}
